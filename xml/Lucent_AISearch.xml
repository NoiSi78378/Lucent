<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent AI Search - all controls are real Kodi controls, remote and touch accessible. -->
<window type="dialog">
    <defaultcontrol always="true">10</defaultcontrol>
    <include>Anim_Dialog</include>
    <controls>
        <include>DialogDim</include>
        <control type="image">
            <left>75</left><top>45</top><width>1770</width><height>990</height>
            <texture border="44" colordiffuse="bg_98">rr20.png</texture>
        </control>
        <control type="image">
            <left>75</left><top>45</top><width>1770</width><height>990</height>
            <texture border="44" colordiffuse="hairline">rr20_edge.png</texture>
        </control>
        <control type="image">
            <left>142</left><top>105</top><width>56</width><height>56</height>
            <texture colordiffuse="text">icons/search.png</texture>
        </control>
        <control type="label">
            <left>220</left><top>102</top><width>1190</width><height>66</height>
            <font>font37</font><textcolor>text</textcolor>
            <label>Lucent AI Search</label>
        </control>
        <control type="label">
            <left>145</left><top>173</top><width>1470</width><height>40</height>
            <font>font12</font><textcolor>text3</textcolor>
            <label>Un titolo preciso o una richiesta libera. I suggerimenti AI non garantiscono la disponibilità.</label>
        </control>
        <control type="button" id="90">
            <left>1683</left><top>95</top><width>96</width><height>84</height>
            <label></label>
            <texturefocus border="30" colordiffuse="focus">pill60.png</texturefocus>
            <texturenofocus border="30" colordiffuse="glass_strong">pill60.png</texturenofocus>
            <onclick>noop</onclick>
            <onleft>14</onleft><ondown>10</ondown>
        </control>
        <control type="image">
            <left>1711</left><top>121</top><width>40</width><height>40</height>
            <texture colordiffuse="text">icons/close.png</texture>
        </control>
        <control type="button" id="10">
            <left>142</left><top>238</top><width>1635</width><height>96</height>
            <label>$INFO[Window.Property(ai.prompt)]</label>
            <font>font27</font><textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
            <textoffsetx>28</textoffsetx><aligny>center</aligny>
            <texturefocus border="28" colordiffuse="focus">rr20.png</texturefocus>
            <texturenofocus border="28" colordiffuse="glass_strong">rr20.png</texturenofocus>
            <ondown>11</ondown><onup>90</onup>
        </control>
        <control type="button" id="11">
            <left>142</left><top>365</top><width>395</width><height>76</height>
            <font>font12_bold</font><align>center</align><aligny>center</aligny>
            <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
            <label>Cerca in Stream4Me</label>
            <texturefocus border="30" colordiffuse="focus">pill60.png</texturefocus>
            <texturenofocus border="30" colordiffuse="card">pill60.png</texturenofocus>
            <onright>12</onright><onup>10</onup><ondown>50</ondown>
        </control>
        <control type="button" id="12">
            <left>554</left><top>365</top><width>337</width><height>76</height>
            <font>font12_bold</font><align>center</align><aligny>center</aligny>
            <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
            <label>Chiedi all'AI</label>
            <texturefocus border="30" colordiffuse="focus">pill60.png</texturefocus>
            <texturenofocus border="30" colordiffuse="card">pill60.png</texturenofocus>
            <onleft>11</onleft><onright>13</onright><onup>10</onup><ondown>50</ondown>
        </control>
        <control type="button" id="13">
            <left>908</left><top>365</top><width>339</width><height>76</height>
            <font>font12_bold</font><align>center</align><aligny>center</aligny>
            <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
            <label>TV in diretta</label>
            <texturefocus border="30" colordiffuse="focus">pill60.png</texturefocus>
            <texturenofocus border="30" colordiffuse="card">pill60.png</texturenofocus>
            <onleft>12</onleft><onright>14</onright><onup>10</onup><ondown>50</ondown>
        </control>
        <control type="button" id="14">
            <left>1264</left><top>365</top><width>513</width><height>76</height>
            <font>font12_bold</font><align>center</align><aligny>center</aligny>
            <textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor>
            <label>Chiave OpenRouter</label>
            <texturefocus border="30" colordiffuse="focus">pill60.png</texturefocus>
            <texturenofocus border="30" colordiffuse="card">pill60.png</texturenofocus>
            <onleft>13</onleft><onup>10</onup><ondown>50</ondown>
        </control>
        <control type="label">
            <left>145</left><top>475</top><width>1640</width><height>38</height>
            <font>font12</font><textcolor>text3</textcolor>
            <scroll>true</scroll><label>$INFO[Window.Property(ai.status)]</label>
        </control>
        <!-- Cinematic poster row: Kodi ListItem.Art(poster) uses asynchronously loaded artwork. -->
        <control type="list" id="50">
            <left>142</left><top>522</top><width>1635</width><height>365</height>
            <orientation>horizontal</orientation>
            <scrolltime tween="cubic" easing="out">200</scrolltime>
            <onup>12</onup><ondown>50</ondown>
            <itemlayout width="322" height="362">
                <control type="image">
                    <left>4</left><top>3</top><width>310</width><height>355</height>
                    <texture border="26" colordiffuse="card">rr20.png</texture>
                </control>
                
                <control type="image">
                    <left>65</left><top>14</top><width>190</width><height>266</height>
                    <texture border="20" colordiffuse="glass_strong">rr20.png</texture>
                </control>
                <control type="image">
                    <left>133</left><top>113</top><width>54</width><height>54</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="text3">$INFO[ListItem.Icon]</texture>
                    <visible>String.IsEmpty(ListItem.Art(poster))</visible>
                </control>
                <control type="image">
                    <left>65</left><top>14</top><width>190</width><height>266</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Art(poster)]</texture>
                    <visible>!String.IsEmpty(ListItem.Art(poster))</visible>
                </control>
                <control type="label">
                    <left>16</left><top>290</top><width>290</width><height>35</height>
                    <font>font12_bold</font><textcolor>text</textcolor>
                    <align>center</align><aligny>center</aligny><scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>17</left><top>324</top><width>288</width><height>29</height>
                    <font>font12</font><textcolor>text3</textcolor>
                    <align>center</align><aligny>center</aligny><scroll>true</scroll>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </itemlayout>
            <focusedlayout width="322" height="362">
                <control type="image">
                    <left>4</left><top>3</top><width>310</width><height>355</height>
                    <texture border="26" colordiffuse="glass_strong">rr20.png</texture>
                </control>
                <control type="image">
                    <left>3</left><top>2</top><width>312</width><height>357</height>
                    <texture border="26" colordiffuse="focus">rr20_edge.png</texture>
                </control>
                <control type="image">
                    <left>65</left><top>14</top><width>190</width><height>266</height>
                    <texture border="20" colordiffuse="glass_strong">rr20.png</texture>
                </control>
                <control type="image">
                    <left>133</left><top>113</top><width>54</width><height>54</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="text3">$INFO[ListItem.Icon]</texture>
                    <visible>String.IsEmpty(ListItem.Art(poster))</visible>
                </control>
                <control type="image">
                    <left>65</left><top>14</top><width>190</width><height>266</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Art(poster)]</texture>
                    <visible>!String.IsEmpty(ListItem.Art(poster))</visible>
                </control>
                <control type="label">
                    <left>16</left><top>290</top><width>290</width><height>35</height>
                    <font>font12_bold</font><textcolor>text</textcolor>
                    <align>center</align><aligny>center</aligny><scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>17</left><top>324</top><width>288</width><height>29</height>
                    <font>font12</font><textcolor>text</textcolor>
                    <align>center</align><aligny>center</aligny><scroll>true</scroll>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </focusedlayout>
        </control>
        <!-- One clean, full-width detail line follows the focused poster. -->
        <control type="image">
            <left>142</left><top>903</top><width>1635</width><height>62</height>
            <texture border="22" colordiffuse="glass_strong">rr20.png</texture>
            <visible>Control.HasFocus(50)</visible>
        </control>
        <control type="label">
            <left>173</left><top>895</top><width>1570</width><height>34</height>
            <font>font12_bold</font><textcolor>text</textcolor>
            <aligny>center</aligny><scroll>true</scroll>
            <label>$INFO[Container(50).ListItem.Label]</label>
            <visible>Control.HasFocus(50)</visible>
        </control>
        <control type="label">
            <left>173</left><top>927</top><width>1570</width><height>29</height>
            <font>font10</font><textcolor>text3</textcolor>
            <aligny>center</aligny><scroll>true</scroll>
            <label>$INFO[Container(50).ListItem.Property(reason)]</label>
            <visible>Control.HasFocus(50)</visible>
        </control>
        <control type="label">
            <left>145</left><top>974</top><width>1590</width><height>34</height>
            <font>font10</font><textcolor>text4</textcolor>
            <label>Premi su un titolo per cercarlo in Stream4Me  ·  Le dirette sono mostrate solo con EPG Kodi disponibile.</label>
        </control>
    </controls>
</window>
